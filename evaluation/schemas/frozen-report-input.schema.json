{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/frozen-report-input-1.0.0.json",
  "title": "Frozen local report input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "report_id", "stage", "scope", "dataset_manifest_sha256", "table_sha256", "figure_sha256", "estimator_sha256", "interval_sha256", "family", "power_sha256", "safety_sha256", "panel_sha256", "cost_revision_sha256", "runtime_lock_sha256", "template_sha256", "gate_ids", "claim_decisions", "claim_scopes", "non_target_intervals", "categorical_policy", "categorical_decisions", "reproduction_status", "sections", "release_fitness"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "frozen_report_input"},
    "report_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "table_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "figure_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "estimator_sha256": {"$ref": "#/$defs/sha256"},
    "interval_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "family": {"type": "object"},
    "power_sha256": {"$ref": "#/$defs/sha256"},
    "safety_sha256": {"$ref": "#/$defs/sha256"},
    "panel_sha256": {"$ref": "#/$defs/sha256"},
    "cost_revision_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "gate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claim_decisions": {"type": "array", "minItems": 1},
    "claim_scopes": {"type": "array", "minItems": 1},
    "non_target_intervals": {"type": "array"},
    "categorical_policy": {"type": "object"},
    "categorical_decisions": {"type": "array", "minItems": 1},
    "release_fitness": {"type": "object"},
    "reproduction_status": {"enum": ["verified", "pending", "failed"]},
    "sections": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
