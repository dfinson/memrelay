{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/schemas/safety-report.schema.json",
  "type": "object",
  "required": ["schema_version", "policy_sha256", "source_manifest_sha256", "source_evidence_sha256", "derivation_sha256", "results", "sensitivity_scenarios", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "source_evidence_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "derivation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "results": {"type": "array"},
    "sensitivity_scenarios": {"type": "array"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
