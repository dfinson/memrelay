{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/conformance-report.schema.json",
  "title": "Immutable executable conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "evidence_label",
    "mode",
    "bootstrap_receipt_sha256",
    "stage_locks",
    "input_hashes",
    "proof_receipts",
    "status",
    "report_id",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_type": {"const": "conformance_report"},
    "evidence_label": {"const": "conformance_not_efficacy_evidence"},
    "mode": {"enum": ["unpaid_ci", "provider_qualification"]},
    "bootstrap_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "stage_locks": {"$ref": "#/$defs/hash_map"},
    "input_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "proof_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/proof_receipt"}
    },
    "status": {"enum": ["passed", "blocked"]},
    "report_id": {"$ref": "#/$defs/sha256"},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hash_map": {
      "type": "object",
      "required": [
        "catalog_sha256", "protocol_sha256", "sdk_sha256", "runtime_lock_sha256",
        "model_lock_sha256", "environment_sha256", "grader_sha256", "judge_sha256",
        "telemetry_sha256", "price_table_sha256", "limits_sha256", "preceding_exit_sha256"
      ],
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "proof_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id", "status", "terminal", "implementation_sha256",
        "runtime_lock_sha256", "protocol_sha256", "environment_sha256",
        "input_hashes", "output_hashes", "failure_evidence_sha256", "receipt_sha256"
      ],
      "properties": {
        "proof_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "unavailable", "interrupted"]},
        "terminal": {"type": "string", "minLength": 1},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "output_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "failure_evidence_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
