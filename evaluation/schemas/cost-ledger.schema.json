{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/cost-ledger-1.0.0.json",
  "title": "Immutable Cost Quantity Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cost_entry_id", "attempt_id", "identity", "source_authority",
    "source_ref", "source_sha256", "quantity", "unit", "measurement_status",
    "observed_at", "price_table_version", "price_table_ref", "currency",
    "conversion_table_version", "conversion_table_sha256", "instrumentation_active",
    "lineage_entry_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "cost_entry_id": {"pattern": "^cost_[a-z0-9]{32}$"},
    "attempt_id": {"pattern": "^attempt_[a-z0-9]{32}$"},
    "identity": {"$ref": "provider-identity.schema.json"},
    "source_authority": {"enum": ["native_provider", "native_local_counter", "native_control_clock", "native_invoice"]},
    "source_ref": {"pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "source_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "quantity": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unavailable"}]},
    "unit": {"enum": ["input_token", "cached_input_token", "cache_write_token", "output_token", "reasoning_token", "ai_credit", "tool_call", "request", "usd", "cpu_second", "byte_second", "disk_byte", "disk_byte_second", "wall_second", "provider_latency_second", "quota_rejection", "throttle_event", "reset_event", "subscription_allowance", "billing_period", "storage_read_operation", "storage_write_operation", "network_operation", "gigabyte_month"]},
    "measurement_status": {"enum": ["metered", "estimated", "subscription_normalized", "invoice_reconciled", "unavailable"]},
    "observed_at": {"format": "date-time"},
    "price_table_version": {"type": "string"},
    "price_table_ref": {"type": "string"},
    "currency": {"type": "string"},
    "conversion_table_version": {"type": "string"},
    "conversion_table_sha256": {"type": "string"},
    "instrumentation_active": {"type": "boolean"},
    "lineage_entry_ids": {"type": "array", "items": {"pattern": "^cost_[a-z0-9]{32}$"}}
  }
}
