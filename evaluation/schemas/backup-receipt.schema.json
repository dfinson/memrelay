{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/schemas/backup-receipt.schema.json",
  "title": "Terminal evidence backup receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_id", "inventory_sha256", "run_id", "attempt_id", "source_volume", "target_volume", "items", "started_at", "completed_at", "highest_terminal_position", "rpo", "tool_version"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generation_id": {"type": "string", "pattern": "^sha256-[a-f0-9]{64}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "source_volume": {"type": "string"},
    "target_volume": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(ledger\\.sqlite|artifacts/)"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "highest_terminal_position": {"type": "integer", "minimum": 0},
    "rpo": {"const": "at_most_active_in_flight_attempt"},
    "tool_version": {"type": "string"}
  }
}
