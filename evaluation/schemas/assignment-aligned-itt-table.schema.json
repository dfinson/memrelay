{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/assignment-aligned-itt-table.schema.json",
  "title": "Memrelay assignment-aligned immutable ITT table",
  "type": "object",
  "required": [
    "schema_version",
    "estimand_fingerprint",
    "registry_sha256",
    "source_dataset_manifest_sha256",
    "observations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "estimand_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_dataset_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observations": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
