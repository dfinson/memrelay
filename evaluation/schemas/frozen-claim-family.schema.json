{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/frozen-claim-family-1.0.0.json",
  "title": "Frozen confirmatory claim family",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "family_id",
    "mode",
    "protocol_sha256",
    "assignment_plan_sha256",
    "source_dataset_manifest_sha256",
    "estimand_registry_sha256",
    "environment_fingerprint_sha256",
    "model_role",
    "endpoint_ids",
    "endpoint_directions",
    "endpoint_scales",
    "endpoint_margins",
    "categorical_gate_ids",
    "efficiency_selection",
    "enrolled_n",
    "alpha",
    "method",
    "method_version",
    "frozen_before_outcomes",
    "sealed_claim_protocol_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "frozen_claim_family"},
    "family_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["reliability", "efficiency", "dual"]},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "assignment_plan_sha256": {"$ref": "#/$defs/sha256"},
    "source_dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "estimand_registry_sha256": {"$ref": "#/$defs/sha256"},
    "environment_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "model_role": {"type": "string", "minLength": 1},
    "endpoint_ids": {"type": "array", "items": {"type": "string"}},
    "endpoint_directions": {
      "type": "array",
      "items": {"enum": ["benefit", "non_inferiority", "superiority", "harm"]}
    },
    "endpoint_scales": {"type": "array", "items": {"enum": ["difference", "ratio"]}},
    "endpoint_margins": {"type": "array", "items": {"type": "number"}},
    "categorical_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "efficiency_selection": {"enum": ["cost", "wall", "intersection", null]},
    "enrolled_n": {"const": 512},
    "alpha": {"const": 0.05},
    "method": {"const": "holm"},
    "method_version": {"const": "1.0.0"},
    "frozen_before_outcomes": {"const": true},
    "sealed_claim_protocol_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "reliability"}}},
      "then": {
        "properties": {
          "endpoint_ids": {"const": ["EP-PRIM-SUCCESS", "EP-QUAL", "EP-HARM"]},
          "endpoint_directions": {"const": ["benefit", "benefit", "harm"]},
          "endpoint_scales": {"const": ["difference", "difference", "difference"]},
          "endpoint_margins": {"const": [0.05, 0.05, -0.02]},
          "efficiency_selection": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "efficiency"}}},
      "then": {
        "properties": {
          "endpoint_ids": {
            "const": ["EP-SUCC-NI", "EP-QUAL", "EP-COST", "EP-WALL", "EP-HARM"]
          },
          "endpoint_directions": {
            "const": ["non_inferiority", "benefit", "superiority", "superiority", "harm"]
          },
          "endpoint_scales": {
            "const": ["difference", "difference", "ratio", "ratio", "difference"]
          },
          "endpoint_margins": {"const": [-0.02, 0.05, 0.9, 0.9, -0.02]},
          "efficiency_selection": {"enum": ["cost", "wall", "intersection"]}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "dual"}}},
      "then": {
        "properties": {
          "endpoint_ids": {
            "const": ["EP-PRIM-SUCCESS", "EP-QUAL", "EP-COST", "EP-WALL", "EP-HARM"]
          },
          "endpoint_directions": {
            "const": ["benefit", "benefit", "superiority", "superiority", "harm"]
          },
          "endpoint_scales": {
            "const": ["difference", "difference", "ratio", "ratio", "difference"]
          },
          "endpoint_margins": {"const": [0.05, 0.05, 0.9, 0.9, -0.02]},
          "efficiency_selection": {"const": "intersection"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
