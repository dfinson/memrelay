{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/evidence-linked-report-1.0.0.json",
  "title": "Evidence linked local report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "report_input_sha256", "renderer_version", "runtime_lock_sha256", "template_sha256", "report_id", "stage", "terminal_status", "scope", "source_authority", "input_hashes", "sections", "claims", "release_fitness"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "evidence_linked_report"},
    "report_input_sha256": {"$ref": "#/$defs/sha256"},
    "renderer_version": {"const": "1.0.0"},
    "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "report_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["verified", "draft/unverified"]},
    "scope": {"type": "object"},
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "source_kind", "dataset_manifest_sha256", "protocol_sha256", "source_sha256", "authority_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_type": {"const": "report_source_authority"},
        "source_kind": {"enum": ["construction", "component_test", "deterministic_fixture", "unreconciled_trial", "engine_upper_bound", "pilot", "completed_reconciled_product"]},
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_hashes": {"type": "object"},
    "sections": {"type": "object"},
    "claims": {"type": "array", "minItems": 1},
    "release_fitness": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
