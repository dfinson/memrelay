{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/monetary-view-1.0.0.json",
  "title": "Immutable Derived Monetary View",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "monetary_view_id", "attempt_id", "category", "monetary_authority", "pricing_status", "amount", "currency", "quantity_entry_sha256", "quantity_artifact_sha256", "quantity_unit", "quantity", "identity", "source_authority", "source_ref", "source_sha256", "observed_at", "model", "billing_region", "price_table_version", "price_table_sha256", "price_table_artifact_sha256", "conversion_table_version", "conversion_table_sha256", "derivation_version", "protocol_sha256", "environment_stratum_sha256", "scenario_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "monetary_view_id": {"pattern": "^money_[a-f0-9]{32}$"},
    "attempt_id": {"pattern": "^attempt_[a-f0-9]{32}$"},
    "category": {"const": "framework_api_metered"},
    "monetary_authority": {"enum": ["estimated", "shadow_sensitivity", "subscription_normalized", "incremental_cash", "framework_api_metered", "invoice_reconciled", "local_variable", "fully_loaded", "study_cost"]},
    "pricing_status": {"enum": ["derived", "unavailable", "not_applicable"]},
    "amount": {"anyOf": [{"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, {"type": "null"}]},
    "currency": {"const": "USD"},
    "quantity_entry_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "quantity_artifact_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "quantity_unit": {"type": "string"},
    "quantity": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unavailable"}]},
    "identity": {"type": "object"},
    "source_authority": {"type": "string"},
    "source_ref": {"type": "string"},
    "source_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "observed_at": {"format": "date-time"},
    "model": {"type": "string"},
    "billing_region": {"type": "string"},
    "price_table_version": {"type": "string"},
    "price_table_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "price_table_artifact_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "conversion_table_version": {"type": "string"},
    "conversion_table_sha256": {"type": "string"},
    "derivation_version": {"const": "1.0.0"},
    "protocol_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "environment_stratum_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "scenario_id": {"type": "string"}
  }
}
