{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/eligible-outcome-authority.schema.json",
  "title": "Memrelay immutable eligible outcome authority",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "endpoint_id",
    "outcome_id",
    "outcome_kind",
    "numeric_value",
    "category_value",
    "unit",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "eligible_outcome_authority" },
    "endpoint_id": { "type": "string", "minLength": 1 },
    "outcome_id": { "type": "string", "minLength": 1 },
    "outcome_kind": { "enum": ["numeric", "categorical"] },
    "numeric_value": { "type": ["number", "null"] },
    "category_value": { "type": ["string", "null"] },
    "unit": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1 }
  }
}
