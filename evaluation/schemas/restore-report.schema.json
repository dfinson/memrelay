{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/schemas/restore-report.schema.json",
  "title": "Quarantined terminal-evidence restore drill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_id", "inventory_sha256", "restore_root", "elapsed_seconds", "verified_item_count", "verified_ledger_link_count", "policy_version", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generation_id": {"type": "string", "pattern": "^sha256-[a-f0-9]{64}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "restore_root": {"type": "string"},
    "elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
    "verified_item_count": {"type": "integer", "minimum": 1},
    "verified_ledger_link_count": {"type": "integer", "minimum": 0},
    "policy_version": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
