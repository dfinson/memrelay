{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/artifact-manifest-1.0.0.json",
  "title": "Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "sha256",
    "size_bytes",
    "media_type",
    "created_at",
    "producer",
    "classification",
    "contains_secrets",
    "source_artifact_ids",
    "retention_policy_id",
    "encryption",
    "scope",
    "experiment_id",
    "run_id",
    "attempt_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "pattern": "^art_[a-f0-9]{32}$"},
    "kind": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "Z$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "classification": {"type": "string", "minLength": 1},
    "contains_secrets": {"type": "boolean"},
    "source_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^art_[a-f0-9]{32}$"}
    },
    "retention_policy_id": {"type": "string", "pattern": "^ret_[a-f0-9]{32}$"},
    "encryption": {
      "type": ["object", "null"],
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "scope": {"enum": ["experiment", "run", "attempt"]},
    "experiment_id": {"type": ["string", "null"], "pattern": "^exp_[a-f0-9]{32}$"},
    "run_id": {"type": ["string", "null"], "pattern": "^run_[a-f0-9]{32}$"},
    "attempt_id": {"type": ["string", "null"], "pattern": "^attempt_[a-f0-9]{32}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "experiment"}}},
      "then": {
        "properties": {
          "experiment_id": {"type": "string"},
          "run_id": {"type": "null"},
          "attempt_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "run"}}},
      "then": {
        "properties": {
          "run_id": {"type": "string"},
          "attempt_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "attempt"}}},
      "then": {
        "properties": {
          "run_id": {"type": "string"},
          "attempt_id": {"type": "string"}
        }
      }
    }
  ]
}
