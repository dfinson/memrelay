{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/telemetry-evidence-1.1.0.json",
  "title": "Versioned Telemetry Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spans"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span_id", "span_class", "started_at", "ended_at", "attributes", "links",
          "memrelay.eval.schema_version", "memrelay.eval.experiment_id",
          "memrelay.eval.protocol_id", "memrelay.eval.run_id", "memrelay.eval.attempt_id",
          "memrelay.eval.scenario_id", "memrelay.eval.stratum_id",
          "memrelay.eval.history_mode", "memrelay.eval.identity_schema_version",
          "memrelay.eval.service_name", "memrelay.eval.provider",
          "memrelay.eval.credential_domain", "memrelay.eval.cost_source",
          "memrelay.eval.resource_identity", "memrelay.eval.operation",
          "memrelay.eval.logical_ledger", "memrelay.eval.source_provider_label",
          "memrelay.eval.evidence_class", "memrelay.eval.exposure_state",
          "memrelay.eval.failure_code", "memrelay.eval.environment_fingerprint_sha256"
        ],
        "properties": {
          "span_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "span_class": {"enum": ["control.assignment", "provisioning", "cleanup", "copilot.session", "copilot.model_request", "mcp.tool_request", "daemon.dispatch", "memory.write", "memory.retrieval", "framework.extraction", "framework.embedding", "grader.execution", "judge.adjudication", "artifact.persistence", "inspect.export", "cost.reconciliation", "evidence.reconciliation"]},
          "started_at": {"type": "string", "pattern": "Z$"},
          "ended_at": {"type": "string", "pattern": "Z$"},
          "attributes": {"type": "object"},
          "links": {"type": "array"},
          "memrelay.eval.schema_version": {"const": "1.1.0"},
          "memrelay.eval.experiment_id": {"type": "string", "pattern": "^exp_[a-f0-9]{32}$"},
          "memrelay.eval.protocol_id": {"type": "string", "pattern": "^protocol_[a-f0-9]{32}$"},
          "memrelay.eval.run_id": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
          "memrelay.eval.attempt_id": {"type": "string", "pattern": "^attempt_[a-f0-9]{32}$"},
          "memrelay.eval.scenario_id": {"type": "string", "pattern": "^scenario_[a-f0-9]{32}$"},
          "memrelay.eval.stratum_id": {"enum": ["product", "direct_engine"]},
          "memrelay.eval.history_mode": {"enum": ["controlled", "dynamic"]},
          "memrelay.eval.identity_schema_version": {"const": "1.0.0"},
          "memrelay.eval.service_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "memrelay.eval.provider": {"enum": ["github_copilot", "openai", "local"]},
          "memrelay.eval.credential_domain": {"enum": ["copilot_subscription", "framework_openai_api", "none"]},
          "memrelay.eval.cost_source": {"enum": ["copilot_subscription_usage", "openai_api_metered", "local_resource"]},
          "memrelay.eval.resource_identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "memrelay.eval.operation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "memrelay.eval.logical_ledger": {"enum": ["copilot_subscription", "framework_openai", "local_resources"]},
          "memrelay.eval.source_provider_label": {"enum": ["github_copilot_sdk", "openai", "local"]},
          "memrelay.eval.evidence_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "memrelay.eval.exposure_state": {"enum": ["unexposed", "exposed", "ambiguous", "unknown", "contradictory"]},
          "memrelay.eval.failure_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "memrelay.eval.environment_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "raw_spans": {"type": "array"},
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "raw_span_ids", "canonical_span_ids", "duplicate_span_ids",
        "missing_classes", "failure_codes", "canonical_projection_digest"
      ],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "raw_span_ids": {"type": "array", "items": {"type": "string"}},
        "canonical_span_ids": {"type": "array", "items": {"type": "string"}},
        "duplicate_span_ids": {"type": "array", "items": {"type": "string"}},
        "missing_classes": {"type": "array", "items": {"type": "string"}},
        "failure_codes": {"type": "array", "items": {"type": "string"}},
        "canonical_projection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
