{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/power-evaluation-1.0.0.json",
  "title": "Immutable frozen power evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "protocol_sha256",
    "power_sha256",
    "family_sha256",
    "sealed_claim_protocol_sha256",
    "status",
    "worst_case_power",
    "cells",
    "independent_spot_check_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "power_evaluation"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "power_sha256": {"$ref": "#/$defs/sha256"},
    "family_sha256": {"$ref": "#/$defs/sha256"},
    "sealed_claim_protocol_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["pass", "estimation_only", "blocked"]},
    "worst_case_power": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "independent_spot_check_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_sha256",
        "status",
        "successful_trials",
        "valid_trials",
        "power",
        "family_sha256",
        "power_endpoint_id",
        "reason"
      ],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1},
        "cell_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["estimated", "invalid"]},
        "successful_trials": {"type": "integer", "minimum": 0},
        "valid_trials": {"type": "integer", "minimum": 0},
        "power": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "family_sha256": {"$ref": "#/$defs/sha256"},
        "power_endpoint_id": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
