{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/sealed-claim-protocol-1.0.0.json",
  "title": "Pre-enrollment sealed claim protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "protocol_sha256", "assignment_plan_sha256", "estimator_registry_sha256", "pre_enrollment_authorization_sha256", "pre_enrollment_state", "registrations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "sealed_claim_protocol"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "assignment_plan_sha256": {"$ref": "#/$defs/sha256"},
    "estimator_registry_sha256": {"$ref": "#/$defs/sha256"},
    "pre_enrollment_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "pre_enrollment_state": {"const": "authorized_before_enrollment"},
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "family_registration_sha256", "threshold_registration_sha256", "power_registration_sha256"],
        "properties": {
          "family_id": {"type": "string", "minLength": 1},
          "family_registration_sha256": {"$ref": "#/$defs/sha256"},
          "threshold_registration_sha256": {"$ref": "#/$defs/sha256"},
          "power_registration_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
