{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/release-fitness-decision-1.0.0.json",
  "title": "Release fitness decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "status", "family_sha256", "protocol_sha256", "population_id", "model_id", "stratum", "history_regime", "environment_sha256", "source_sha256", "derivation_sha256", "evidence_sha256", "categorical_gate_decision_sha256", "target_claim_decision_sha256", "non_target_interval_sha256", "reproduction_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "release_fitness_decision"},
    "status": {"enum": ["pass", "fail", "blocked", "draft/unverified"]},
    "family_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "population_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "stratum": {"type": "string", "minLength": 1},
    "history_regime": {"type": "string", "minLength": 1},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "derivation_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "categorical_gate_decision_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "target_claim_decision_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "non_target_interval_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "reproduction_status": {"enum": ["verified", "pending", "failed"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
