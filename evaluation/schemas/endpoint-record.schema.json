{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/endpoint-record-1.0.0.json",
  "title": "Normalized Outcome Endpoint Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "endpoint",
    "authority",
    "status",
    "value",
    "unavailable_reason",
    "scorer_sha256",
    "rubric_sha256",
    "grader_sha256",
    "snapshot_sha256",
    "protocol_sha256",
    "source_evidence_sha256",
    "derivation_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "endpoint": {"enum": ["hard", "qualitative"]},
    "authority": {"enum": ["deterministic_grader", "blinded_judge_panel"]},
    "status": {"enum": ["passed", "failed", "unavailable", "blocked"]},
    "value": {"type": ["boolean", "number", "null"]},
    "unavailable_reason": {"type": ["string", "null"], "minLength": 1},
    "scorer_sha256": {"$ref": "#/$defs/sha256"},
    "rubric_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "grader_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "snapshot_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "protocol_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "source_evidence_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "derivation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"endpoint": {"const": "hard"}}},
      "then": {
        "properties": {
          "authority": {"const": "deterministic_grader"},
          "value": {"type": ["boolean", "null"]}
        }
      },
      "else": {
        "properties": {
          "authority": {"const": "blinded_judge_panel"},
          "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["passed", "failed"]}}},
      "then": {
        "properties": {"value": {"not": {"type": "null"}}, "unavailable_reason": {"type": "null"}}
      },
      "else": {
        "properties": {"value": {"type": "null"}, "unavailable_reason": {"type": "string", "minLength": 1}}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
