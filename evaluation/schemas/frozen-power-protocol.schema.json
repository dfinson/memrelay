{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrelay.dev/evaluation/schemas/frozen-power-protocol-1.0.0.json",
  "title": "Frozen family-aware simulation power protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "protocol_sha256",
    "family_sha256",
    "family",
    "assignment_plan_sha256",
    "estimator_registry_sha256",
    "endpoint_estimand_fingerprints",
    "sealed_claim_protocol_sha256",
    "power_registration_sha256",
    "fixed_n",
    "simulation_trials",
    "power_endpoint_id",
    "target_power",
    "estimator_version",
    "frozen_before_outcomes",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "frozen_power_protocol"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "family_sha256": {"$ref": "#/$defs/sha256"},
    "family": {"$ref": "frozen-claim-family.schema.json"},
    "assignment_plan_sha256": {"$ref": "#/$defs/sha256"},
    "estimator_registry_sha256": {"$ref": "#/$defs/sha256"},
    "endpoint_estimand_fingerprints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "sealed_claim_protocol_sha256": {"$ref": "#/$defs/sha256"},
    "power_registration_sha256": {"$ref": "#/$defs/sha256"},
    "fixed_n": {"const": 512},
    "simulation_trials": {"type": "integer", "minimum": 10000},
    "power_endpoint_id": {"type": "string", "minLength": 1},
    "target_power": {"const": 0.8},
    "estimator_version": {"const": "1.0.0"},
    "frozen_before_outcomes": {"const": true},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "seed",
        "endpoint_target_effects",
        "endpoint_scales",
        "endpoint_baselines",
        "correlation",
        "assignment_design",
        "estimator",
        "nuisance_source",
        "missingness_rate",
        "attrition_rate",
        "contamination_rate",
        "censoring_rate",
        "block_count",
        "pair_count",
        "cluster_count",
        "sequence_count",
        "pair_correlation",
        "cluster_icc",
        "missingness_mechanism",
        "attrition_mechanism",
        "contamination_mechanism",
        "censoring_policy",
        "target_effect_source",
        "invalid_reason"
      ],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "endpoint_target_effects": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        },
        "endpoint_scales": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["difference", "ratio"]}
        },
        "endpoint_baselines": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "correlation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number", "minimum": -1, "maximum": 1}
          }
        },
        "assignment_design": {"enum": ["blocked", "paired", "clustered", "sequence"]},
        "estimator": {
          "enum": [
            "block_adjusted_difference",
            "paired_difference",
            "cluster_robust_difference",
            "sequence_adjusted_difference"
          ]
        },
        "nuisance_source": {"enum": ["baseline_only", "arm_blind_escrow"]},
        "missingness_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "attrition_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "contamination_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "censoring_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "block_count": {"type": ["integer", "null"], "minimum": 2},
        "pair_count": {"type": ["integer", "null"], "minimum": 2},
        "cluster_count": {"type": ["integer", "null"], "minimum": 2},
        "sequence_count": {"type": ["integer", "null"], "minimum": 2},
        "pair_correlation": {
          "type": ["number", "null"],
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "cluster_icc": {
          "type": ["number", "null"],
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "missingness_mechanism": {"const": "mcar"},
        "attrition_mechanism": {"const": "differential_arm"},
        "contamination_mechanism": {"const": "cross_arm"},
        "censoring_policy": {"const": "administrative"},
        "target_effect_source": {"const": "protocol_preregistered"},
        "invalid_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"assignment_design": {"const": "blocked"}}},
          "then": {
            "properties": {
              "estimator": {"const": "block_adjusted_difference"},
              "pair_count": {"const": null},
              "cluster_count": {"const": null},
              "sequence_count": {"const": null},
              "pair_correlation": {"const": null},
              "cluster_icc": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"assignment_design": {"const": "paired"}}},
          "then": {
            "properties": {
              "estimator": {"const": "paired_difference"},
              "block_count": {"const": null},
              "cluster_count": {"const": null},
              "sequence_count": {"const": null},
              "cluster_icc": {"const": null}
            },
            "required": ["pair_correlation"]
          }
        },
        {
          "if": {"properties": {"assignment_design": {"const": "clustered"}}},
          "then": {
            "properties": {
              "estimator": {"const": "cluster_robust_difference"},
              "block_count": {"const": null},
              "pair_count": {"const": null},
              "sequence_count": {"const": null},
              "pair_correlation": {"const": null}
            },
            "required": ["cluster_icc"]
          }
        },
        {
          "if": {"properties": {"assignment_design": {"const": "sequence"}}},
          "then": {
            "properties": {
              "estimator": {"const": "sequence_adjusted_difference"},
              "block_count": {"const": null},
              "pair_count": {"const": null},
              "cluster_count": {"const": null},
              "pair_correlation": {"const": null},
              "cluster_icc": {"const": null}
            }
          }
        }
      ]
    }
  }
}
